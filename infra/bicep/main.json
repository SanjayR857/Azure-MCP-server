                "description": "Triggers when Container App restarts more than 2 times in 5 minutes (possible crash loop).",
                "severity": 1,
                "enabled": true,
                "scopes": [
                  "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
