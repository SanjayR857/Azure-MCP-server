                  "name": "MCP_RESOURCE_URL",
                  "value": "[format('https://{0}.{1}/mcp', parameters('containerAppName'), reference(resourceId('Microsoft.App/managedEnvironments', parameters('containerEnvironmentName')), '2024-03-01').defaultDomain)]"
